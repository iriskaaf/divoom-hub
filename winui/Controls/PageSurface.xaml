<UserControl
    x:Class="divoom_hub_winui3.PageSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ContentArea">
        <StackPanel x:Name="Layout" MaxWidth="1120" Padding="28,24,28,32" Spacing="18">
            <Button x:Name="BackButton" Click="GoBack" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Back"/>
                    <TextBlock Text="Назад"/>
                </StackPanel>
            </Button>
            <StackPanel x:Name="HeadingRow" Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="Heading" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" OpticalMarginAlignment="TrimSideBearings"/>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,8,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <InfoBar x:Name="Notice" IsClosable="False" Visibility="Collapsed"/>
            <StackPanel x:Name="Body" Spacing="18"/>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
