<Window x:Class="divoom_hub_winui3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Divoom Hub">
    <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
    <Grid x:Name="Root" RowDefinitions="Auto,*" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <TitleBar x:Name="HubTitleBar" Title="Divoom Hub">
            <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/logo.png"/></TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="220"
            ExpandedModeThresholdWidth="1000" SelectionChanged="NavigationChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#333333"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E6E6E6"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Главная" Icon="Home" Tag="home"/>
                <NavigationViewItemSeparator x:Name="DeviceSeparator"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutItem" Content="О программе" Icon="Help" Tag="about"/>
                <NavigationViewItem x:Name="SettingsItem" Content="Настройки" Icon="Setting" Tag="settings"/>
            </NavigationView.FooterMenuItems>
            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.ContentTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></ContentControl.ContentTransitions>
            </ContentControl>
        </NavigationView>
        <ContentControl x:Name="SetupHost" Grid.Row="1" Visibility="Collapsed"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <ContentControl.ContentTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></ContentControl.ContentTransitions>
        </ContentControl>
    </Grid>
</Window>
